---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const servicios = [
	{
		label: "Puerta de entrada",
		labelClass: "text-cyan-600 ring-cyan-400/40",
		title: "Diagnóstico Institucional",
		body: "Relevamiento del clima organizacional, los vínculos entre actores y los procesos de liderazgo. Identifica los nudos reales antes de proponer soluciones.",
		meta: [["Entregable", "Mapa de situación + ejes de mejora priorizados"], ["Duración", "4 a 6 semanas"]],
	},
	{
		label: "Servicio principal",
		labelClass: "text-iris-600 ring-iris-400/40",
		title: "Acompañamiento de Equipos Directivos",
		body: "Desarrollo de liderazgo educativo con foco en la cultura institucional, la gestión de equipos y la toma de decisiones. Talleres, sesiones individuales y seguimiento continuo.",
		meta: [["Formato", "Talleres + sesiones de seguimiento"], ["Duración", "3 a 6 meses"]],
	},
	{
		label: "Servicio principal",
		labelClass: "text-iris-600 ring-iris-400/40",
		title: "Diseño de Procesos de Inducción",
		body: "Para instituciones que incorporan personas nuevas y necesitan un proceso efectivo, reproducible y coherente con su cultura. Diseño del recorrido, materiales y métricas.",
		meta: [["Entregable", "Proceso documentado listo para implementar"], ["Alcance", "Proyecto cerrado"]],
	},
	{
		label: "Complementario",
		labelClass: "text-violet-600 ring-violet-400/40",
		title: "Implementación de +EduMap",
		body: "Acompañamiento especializado para centros y clínicas que adoptan la plataforma: formación del equipo técnico y docente, configuración de protocolos y supervisión de los primeros ciclos de uso.",
		meta: [["Incluido en", "Planes Estándar y Premium de +EduMap"]],
	},
];
---

<Layout
	title="Consultoría — +EDU Consultora"
	description="Acompañamos a centros educativos en procesos de cambio real: diagnóstico institucional, desarrollo de equipos directivos, inducción e implementación de +EduMap."
>
	<PageHero eyebrow="Consultoría" tag="Disponible hoy">
		<Fragment slot="title">
			Acompañamos el cambio <span class="text-gradient italic">desde adentro</span>
		</Fragment>
		<Fragment slot="intro">
			No desde un escritorio: desde el conocimiento profundo de lo que ocurre dentro
			de una institución cuando algo no funciona —y de cómo cambiarlo.
		</Fragment>
	</PageHero>

	<!-- entry point highlight -->
	<section class="bg-white py-16">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="flex flex-col items-start gap-6 rounded-4xl border border-cyan-200 bg-cyan-50/60 p-8 sm:flex-row sm:items-center sm:p-10" data-reveal>
				<div class="flex h-14 w-14 flex-none items-center justify-center rounded-2xl bg-white text-cyan-600 shadow-soft">
					<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.68l1.5 4.5a1 1 0 01-.5 1.21l-2.26 1.13a11 11 0 005.52 5.52l1.13-2.26a1 1 0 011.21-.5l4.5 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z"></path></svg>
				</div>
				<div>
					<p class="font-display text-xl text-ink-900 sm:text-2xl">El punto de entrada es siempre una llamada de diagnóstico gratuita de 30 minutos.</p>
					<p class="mt-2 text-ink-600">Sin compromiso. Para entender qué está pasando antes de proponer nada.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- services -->
	<section class="bg-white pb-24 md:pb-28">
		<div class="mx-auto max-w-5xl px-5 sm:px-8">
			<div class="space-y-5">
				{servicios.map((s, i) => (
					<div class="group rounded-4xl border border-ink-100 bg-white p-8 transition-shadow duration-300 hover:shadow-soft sm:p-10" data-reveal>
						<div class="flex items-baseline gap-4">
							<span class="font-display text-3xl text-ink-200">{String(i + 1).padStart(2, "0")}</span>
							<span class={`eyebrow rounded-full px-3 py-1 text-[0.62rem] ring-1 ${s.labelClass}`}>{s.label}</span>
						</div>
						<h3 class="mt-4 font-display text-2xl text-ink-900 sm:text-3xl">{s.title}</h3>
						<p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-600">{s.body}</p>
						<div class="mt-6 flex flex-wrap gap-x-10 gap-y-3 border-t border-ink-100 pt-5">
							{s.meta.map(([k, v]) => (
								<div>
									<dt class="eyebrow text-ink-400">{k}</dt>
									<dd class="mt-1 font-medium text-ink-800">{v}</dd>
								</div>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<CtaBand
		title="¿Tu institución está atravesando un cambio?"
		text="Empecemos por una llamada de diagnóstico gratuita de 30 minutos para entender los nudos reales."
	/>
</Layout>
