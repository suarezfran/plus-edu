---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const modulos = [
	{
		n: "Módulo 1",
		title: "Despistaje y Detección",
		accent: "from-cyan-400 to-iris-500",
		features: [
			"Cribado grupal sistemático con instrumentos psicopedagógicos validados.",
			"Dashboard grupal: mapa de calor, percentiles, correlaciones y comparativa temporal.",
			"Sistema de alertas cuando un estudiante no muestra progreso en el plazo definido.",
			"Protocolo de derivación: informe psicopedagógico profesional exportable en PDF.",
			"Historial de resultados comparable a lo largo del tiempo.",
		],
	},
	{
		n: "Módulo 2",
		title: "Adecuación Curricular",
		accent: "from-iris-500 to-violet-500",
		features: [
			"Perfil integral del estudiante: historia clínica, diagnóstico, objetivos y estilo de aprendizaje.",
			"Editor de adecuaciones en cuatro dimensiones: acceso, metodológica, evaluativa y curricular.",
			"Integración de metodologías activas: ABP, flipped classroom, gamificación, cooperativo.",
			"Generador de rúbricas diferenciadas vinculadas a los objetivos de cada perfil.",
			"Registro de evaluación formativa y sumativa con seguimiento longitudinal.",
		],
	},
];

const perfiles = [
	{
		title: "Equipo Psicopedagógico",
		dot: "bg-cyan-400",
		body: "Panel técnico con acceso completo a datos clínicos, carga de perfiles, configuración de instrumentos, baremos y criterios de derivación.",
	},
	{
		title: "Docente de Aula",
		dot: "bg-iris-500",
		body: "Panel pedagógico accesible: el perfil del estudiante en lenguaje claro, recomendaciones por materia y una biblioteca de metodologías activas.",
	},
	{
		title: "Profesional / Clínica",
		dot: "bg-violet-500",
		body: "Panel clínico autónomo para gestionar la cartera propia de casos, con batería de instrumentos, informes y agenda de reevaluaciones.",
	},
];
---

<Layout
	title="+EduMap — Plataforma de gestión psicopedagógica | +EDU"
	description="+EduMap sistematiza la detección, los perfiles, las adecuaciones curriculares y el seguimiento longitudinal para centros, profesionales y clínicas."
>
	<PageHero eyebrow="+EduMap" tag="En desarrollo">
		<Fragment slot="title">
			La plataforma de gestión <span class="text-gradient italic">psicopedagógica</span> integral
		</Fragment>
		<Fragment slot="intro">
			Sistematiza y sostiene en el tiempo lo que el conocimiento construye: detecta
			señales de riesgo, gestiona perfiles, documenta adecuaciones, coordina equipos
			y deriva con informes profesionales completos.
		</Fragment>
	</PageHero>

	<!-- privacy -->
	<section class="bg-white py-14">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="flex flex-col gap-4 rounded-4xl border border-ink-100 bg-lavender-50 p-8 sm:flex-row sm:items-center sm:gap-6 sm:p-9" data-reveal>
				<svg class="h-8 w-8 flex-none text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 3l7 4v5c0 4.5-3 8.5-7 9.5-4-1-7-5-7-9.5V7l7-4z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9.5 12.5l1.8 1.8 3.5-3.8"></path></svg>
				<p class="text-lg text-ink-700">
					Cada cliente accede a su propio <strong class="font-semibold text-ink-900">entorno privado e independiente</strong>.
					Los datos son exclusivos de esa institución y no se comparten con ningún otro usuario.
				</p>
			</div>
		</div>
	</section>

	<!-- two modules -->
	<section class="bg-white pb-8">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="mb-12 max-w-2xl" data-reveal>
				<p class="eyebrow mb-5 text-violet-600">Cómo funciona</p>
				<h2 class="font-display text-4xl text-ink-900 sm:text-5xl">Dos módulos centrales</h2>
				<p class="mt-5 text-lg text-ink-600">El orden refleja el recorrido real: primero se detecta, luego se adecúa.</p>
			</div>
			<div class="grid gap-5 lg:grid-cols-2">
				{modulos.map((m) => (
					<div class="flex flex-col rounded-4xl border border-ink-100 bg-white p-8 sm:p-10" data-reveal>
						<div class={`mb-6 inline-flex w-fit items-center rounded-full bg-gradient-to-r ${m.accent} px-4 py-1.5 text-sm font-semibold text-white`}>{m.n}</div>
						<h3 class="font-display text-2xl text-ink-900 sm:text-3xl">{m.title}</h3>
						<ul class="mt-6 space-y-4">
							{m.features.map((f) => (
								<li class="flex gap-3 text-ink-600">
									<svg class="mt-1.5 h-4 w-4 flex-none text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
									<span>{f}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- three profiles -->
	<section class="bg-white py-24 md:py-28">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="mb-12 max-w-2xl" data-reveal>
				<p class="eyebrow mb-5 text-violet-600">Un mismo sistema</p>
				<h2 class="font-display text-4xl text-ink-900 sm:text-5xl">Tres perfiles de usuario</h2>
			</div>
			<div class="grid gap-5 md:grid-cols-3">
				{perfiles.map((p) => (
					<div class="rounded-4xl bg-ink-900 p-8 text-white" data-reveal>
						<span class={`mb-6 block h-3 w-3 rounded-full ${p.dot}`}></span>
						<h3 class="font-display text-xl">{p.title}</h3>
						<p class="mt-4 text-white/65">{p.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<CtaBand
		title="¿Querés ser de los primeros centros en usar +EduMap?"
		text="La plataforma está en desarrollo. Sumate a la conversación y te acompañamos en la adopción desde el inicio."
	/>
</Layout>
