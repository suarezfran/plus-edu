---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { contact } from "../lib/site.ts";

const quizas = [
	"La distancia entre los informes psicopedagógicos y lo que realmente pasa en el aula.",
	"La dificultad para formar a tus docentes en algo que tenga impacto real.",
	"La sensación de que hay estudiantes que necesitan algo que la institución todavía no sabe cómo darles.",
];

const canales = [
	{ label: "WhatsApp", value: contact.whatsapp, href: contact.whatsappHref, icon: "wa" },
	{ label: "Email", value: contact.email, href: contact.emailHref, icon: "mail" },
	{ label: "Instagram", value: contact.instagram, href: contact.instagramHref, icon: "ig" },
	{ label: "LinkedIn", value: contact.linkedin, href: contact.linkedinHref, icon: "li" },
	{ label: "Web", value: contact.site, href: contact.siteHref, icon: "web" },
];
---

<Layout
	title="Contacto — +EDU Consultora"
	description="El primer paso es una conversación de 30 minutos. Escribinos por WhatsApp o email para entender la situación de tu institución."
>
	<PageHero eyebrow="El primer paso">
		<Fragment slot="title">
			¿Tu institución se <span class="text-gradient italic">reconoce</span> en esto?
		</Fragment>
		<Fragment slot="intro">
			Si llegaste hasta aquí es porque algo de lo que planteamos resuena con lo que
			vivís dentro de tu centro.
		</Fragment>
	</PageHero>

	<section class="bg-white py-20 md:py-28">
		<div class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
			<!-- reflection + signature -->
			<div data-reveal>
				<p class="text-lg text-ink-500">Quizás es…</p>
				<ul class="mt-6 space-y-5">
					{quizas.map((q, i) => (
						<li class="flex gap-4">
							<span class="font-display text-2xl leading-none text-gradient">{String(i + 1).padStart(2, "0")}</span>
							<p class="text-xl leading-relaxed text-ink-800">{q}</p>
						</li>
					))}
				</ul>
				<p class="mt-10 max-w-lg text-lg leading-relaxed text-ink-600">
					No hace falta tener todo claro para hablar. El punto de partida es siempre
					el mismo: una conversación de 30 minutos para entender la situación de tu
					institución y ver si +EDU puede acompañarte.
				</p>
				<div class="mt-10 flex items-center gap-4 border-t border-ink-100 pt-8">
					<img
						src="/marcela.png"
						alt="Marcela Cuenca"
						width="880"
						height="880"
						class="h-14 w-14 rounded-full object-cover ring-2 ring-violet-200"
					/>
					<div>
						<p class="font-semibold text-ink-900">{contact.person}</p>
						<p class="text-sm text-ink-500">Fundadora de +EDU</p>
					</div>
				</div>
			</div>

			<!-- contact card -->
			<div class="relative overflow-hidden rounded-[2rem] bg-ink-900 p-8 text-white sm:p-10" data-reveal style="--reveal-delay:120ms">
				<div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-violet-600/25 blur-[80px]"></div>
				<div class="relative">
					<h2 class="font-display text-2xl sm:text-3xl">Escribinos</h2>
					<p class="mt-2 text-white/65">Respondemos personalmente. Elegí el canal que prefieras.</p>

					<a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer"
						class="group mt-8 flex items-center justify-between gap-4 rounded-2xl bg-gradient-to-r from-cyan-400 to-violet-500 px-6 py-5 font-semibold text-ink-950 transition-transform duration-300 hover:-translate-y-0.5">
						<span class="flex items-center gap-3">
							<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.5 14.4c-.3-.1-1.7-.9-2-1-.3-.1-.5-.1-.6.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-1.5-.7-2.4-1.3-3.4-3-.3-.4.3-.4.7-1.3.1-.2 0-.4 0-.5 0-.1-.6-1.5-.8-2.1-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.3 1.8.7 2.5.8 3.3.7.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.3-.1-.2-.3-.2-.6-.3z"/><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1112 20.2z"/></svg>
							WhatsApp
						</span>
						<span class="flex items-center gap-2 text-ink-900/80">{contact.whatsapp}
							<svg class="h-5 w-5 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
						</span>
					</a>

					<ul class="mt-4 divide-y divide-white/10">
						{canales.filter((c) => c.icon !== "wa").map((c) => (
							<li>
								<a href={c.href} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 py-4 transition-colors hover:text-cyan-300">
									<span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-white/5 text-white/70 group-hover:text-cyan-300">
										{c.icon === "mail" && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 8l9 6 9-6M5 5h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z"></path></svg>}
										{c.icon === "ig" && <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.9c-.1 3.2-1.6 4.8-4.9 4.9-1.3.1-1.6.1-4.9.1s-3.6 0-4.9-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.1 15.6 2.1 15.2 2.1 12s0-3.6.1-4.9C2.3 3.9 3.8 2.4 7.1 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 5a4.8 4.8 0 100 9.6 4.8 4.8 0 000-9.6zm0 7.9a3.1 3.1 0 110-6.2 3.1 3.1 0 010 6.2zm5-8.1a1.1 1.1 0 100 2.2 1.1 1.1 0 000-2.2z"/></svg>}
										{c.icon === "li" && <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5A2.5 2.5 0 102.5 6a2.5 2.5 0 002.48-2.5zM3 8.5h4V21H3V8.5zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4 0 4.75 2.65 4.75 6.1V21h-4v-5.9c0-1.4 0-3.2-1.95-3.2s-2.25 1.5-2.25 3.1V21H9V8.5z"/></svg>}
										{c.icon === "web" && <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18"></path></svg>}
									</span>
									<span class="flex-1">
										<span class="block text-sm text-white/45">{c.label}</span>
										<span class="block break-all text-white/90">{c.value}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>
</Layout>
