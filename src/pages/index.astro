---
import Layout from "../layouts/Layout.astro";
import Arch from "../components/Arch.astro";
import Button from "../components/Button.astro";
import { contact } from "../lib/site.ts";

const pillars = [
	{
		name: "Capacitación",
		bar: "bg-cyan-400",
		nameColor: "text-cyan-600",
		status: "Disponible hoy",
		statusClass: "bg-cyan-50 text-cyan-700",
		title: "Formación docente y de equipos",
		body: "Cuatro líneas formativas —in-house o abiertas— para equipos docentes, directivos, estudiantes y familias.",
		items: ["Innovación Pedagógica", "Bullying y Convivencia", "Manejo de Aula", "IA en Educación"],
		href: "#capacitaciones",
	},
	{
		name: "Consultoría",
		bar: "bg-violet-500",
		nameColor: "text-violet-600",
		status: "Disponible hoy",
		statusClass: "bg-violet-50 text-violet-700",
		title: "Acompañamiento institucional",
		body: "Diagnóstico, acompañamiento de equipos directivos y diseño de procesos para centros que buscan una transformación real.",
		items: ["Diagnóstico Institucional", "Equipos Directivos", "Diseño de Inducción", "Implementación plataforma"],
		href: "#consultoria",
	},
	{
		name: "+EduMap",
		bar: "bg-gradient-to-r from-cyan-400 to-violet-500",
		nameColor: "text-iris-600",
		status: "En desarrollo",
		statusClass: "bg-lavender-200 text-iris-700",
		title: "Plataforma psicopedagógica",
		body: "Sistema SaaS de despistaje, perfiles, adecuaciones curriculares, derivación y seguimiento longitudinal.",
		items: ["Despistaje grupal", "Adecuación curricular", "Derivación profesional", "Seguimiento longitudinal"],
		href: "#edumap",
	},
];

const valores = [
	{ dot: "bg-cyan-400", t: "Personalización", d: "Diagnósticos previos, planes a medida y adecuaciones configurables para cada institución." },
	{ dot: "bg-violet-500", t: "Accesibilidad del conocimiento", d: "El saber especializado no puede quedar reservado a pocos. Guías prácticas e interfaz intuitiva." },
	{ dot: "bg-cyan-400", t: "Rigor basado en evidencia", d: "Instrumentos validados, marcos DUA y RTI, fuentes académicas citadas." },
	{ dot: "bg-violet-500", t: "Compromiso con la inclusión", d: "Herramientas para técnicos, docentes y familias, articuladas en un mismo ecosistema." },
	{ dot: "bg-cyan-400", t: "Puente diagnóstico–acción", d: "La plataforma traduce perfiles clínicos en recomendaciones concretas para el aula." },
	{ dot: "bg-violet-500", t: "Desde adentro", d: "Asesoramos desde la experiencia real de gestionar instituciones educativas activas." },
];

const marcelaHitos = [
	{ k: "Desde hace 20 años", d: "Lidera diversos proyectos de impacto a nivel nacional, tanto en modalidades presenciales como online. Piensa y desarrolla la unidad de e-learning de un reconocido centro de estudio." },
	{ k: "Hoy", d: "Trabaja en 3 centros educativos de manera activa: dirige innovación pedagógica en relación a propuestas que apuntan a la formación técnica laboral. Es docente en 2 centros educativos a nivel secundaria y articula el equipo de bienestar estudiantil de uno de ellos." },
];

const capacitaciones = [
	{ n: "1", t: "Innovación Pedagógica", p: "Equipos docentes y coordinadores", dur: "4 hs o 3 sesiones", grad: "from-cyan-400 to-iris-500" },
	{ n: "2", t: "Bullying y Convivencia Escolar", p: "Docentes, bienestar, directivos", dur: "6 hs o 4 sesiones", grad: "from-iris-500 to-violet-500" },
	{ n: "3", t: "Manejo de Aula", p: "Docentes de todos los niveles", dur: "3 sesiones o jornada 6 hs", grad: "from-cyan-400 to-iris-500" },
	{ n: "4A", t: "IA en Educación — Docentes", p: "Docentes de todos los niveles", dur: "3 sesiones de 2 hs", grad: "from-iris-500 to-violet-500" },
	{ n: "4B", t: "IA en Educación — Estudiantes", p: "Bachillerato (15–18 años)", dur: "2 sesiones de 2 hs", grad: "from-cyan-400 to-iris-500" },
	{ n: "4C", t: "IA en Educación — Familias", p: "Padres, madres y familias", dur: "Charla-taller 2 hs", grad: "from-iris-500 to-violet-500" },
];

const servicios = [
	{ tag: "Puerta de entrada", tagClass: "bg-cyan-50 text-cyan-700", t: "Diagnóstico Institucional", d: "Relevamiento del clima organizacional, los vínculos entre actores y los procesos de liderazgo.", meta: "Entregable: mapa de situación + ejes de mejora priorizados · 4 a 6 semanas" },
	{ tag: "Servicio principal", tagClass: "bg-violet-50 text-violet-700", t: "Acompañamiento de Equipos Directivos", d: "Proceso de desarrollo de liderazgo educativo: cultura institucional, gestión de equipos y toma de decisiones.", meta: "3 a 6 meses · Talleres + sesiones de seguimiento" },
	{ tag: "Servicio principal", tagClass: "bg-cyan-50 text-cyan-700", t: "Diseño de Procesos de Inducción", d: "Para instituciones que incorporan personas nuevas y necesitan un proceso efectivo, reproducible y coherente.", meta: "Entregable documentado listo para implementar · Proyecto cerrado" },
	{ tag: "Complementario", tagClass: "bg-violet-50 text-violet-700", t: "Implementación de +EduMap", d: "Acompañamiento especializado para centros y clínicas que adopten la plataforma.", meta: "Incluido en planes Estándar y Premium de +EduMap" },
];

const eduMod1 = [
	"Despistaje grupal en minutos, con instrumentos validados",
	"Dashboard con mapa de calor, percentiles y evolución en el tiempo",
	"Alertas automáticas ante falta de progreso",
];
const eduMod2 = [
	"Perfil integral: fortalezas, diagnóstico y metas de aprendizaje",
	"Editor en 4 dimensiones: acceso, metodológica, evaluativa, curricular",
	"Integración de metodologías activas: ABP, flipped, gamificación",
	"Evaluación formativa y portafolio digital longitudinal",
];

const audiencia = [
	"Colegios privados de primaria y secundaria",
	"Centros formales e informales de Uruguay y LATAM",
	"Acceden a los tres pilares: capacitación, consultoría y plataforma",
];
---

<Layout
	title="+EDU Consultora — Transformamos centros educativos en comunidades reales"
	description="+EDU transforma centros educativos en comunidades reales mediante capacitación docente, consultoría institucional y la plataforma psicopedagógica +EduMap. Uruguay y LATAM."
>
	<!-- ============ 1 · HERO ============ -->
	<section id="top" class="bg-ink-900 text-white">
		<div class="mx-auto max-w-6xl px-5 pt-40 pb-32 sm:px-8 lg:pt-48 lg:pb-44">
			<h1 class="max-w-4xl font-display text-[2.9rem] font-bold leading-[1.06] sm:text-6xl xl:text-[4.6rem]" data-reveal>
				Transformamos centros educativos en comunidades reales.
			</h1>
			<p class="mt-8 max-w-2xl text-lg leading-relaxed text-white/70 sm:text-xl" data-reveal style="--reveal-delay:160ms">
				Donde estudiantes, docentes y familias dialogan, son atendidos y se
				desarrollan.
			</p>
			<div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal style="--reveal-delay:240ms">
				<Button href={contact.whatsappCtaHref} variant="light" arrow>Conversemos 30 minutos</Button>
				<a href="#ecosistema" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3.5 font-semibold text-white transition-colors duration-300 hover:bg-white/5">
					Conocé el ecosistema
				</a>
			</div>
		</div>
	</section>

	<!-- ============ 2 · QUIÉNES SOMOS (split) ============ -->
	<section id="quienes" class="bg-white py-24 md:py-32">
		<div class="mx-auto grid max-w-5xl gap-6 px-5 sm:px-8 md:grid-cols-2">
			<div class="rounded-4xl bg-lavender-100 p-9 sm:p-11" data-reveal>
				<h3 class="mb-4 font-display text-2xl text-cyan-600 sm:text-3xl">Misión</h3>
				<p class="text-lg leading-relaxed text-ink-700">
					Transformar centros educativos en comunidades donde estudiantes,
					docentes y familias dialoguen de forma genuina, sus necesidades sean
					atendidas y cada persona encuentre las condiciones para su desarrollo
					personal.
				</p>
			</div>
			<div class="rounded-4xl bg-lavender-100 p-9 sm:p-11" data-reveal style="--reveal-delay:120ms">
				<h3 class="mb-4 font-display text-2xl text-violet-600 sm:text-3xl">Visión</h3>
				<p class="text-lg leading-relaxed text-ink-700">
					Ser la organización de referencia en América Latina para quienes
					quieren que su institución educativa sea una comunidad donde el diálogo
					es genuino, las necesidades tienen respuesta y el desarrollo personal
					es una realidad cotidiana.
				</p>
			</div>
		</div>
	</section>

	<!-- ============ 3 · VALORES ============ -->
	<section class="bg-lavender-100 py-24 md:py-32">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<h2 class="font-display text-4xl text-ink-900 sm:text-5xl" data-reveal>Nuestros valores</h2>
			<div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{valores.map((v, i) => (
					<div class="rounded-3xl bg-white p-7 shadow-soft" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
						<span class={`inline-block h-3.5 w-3.5 rounded-full ${v.dot}`}></span>
						<h3 class="mt-4 font-display text-xl text-ink-900">{v.t}</h3>
						<p class="mt-2.5 text-ink-600">{v.d}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============ 4 · MARCELA ============ -->
	<section class="bg-ink-900 py-24 text-white md:py-32">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<div data-reveal>
				<p class="eyebrow mb-5 text-cyan-300">La persona detrás de +EDU</p>
				<h2 class="font-display text-4xl sm:text-6xl">Marcela Cuenca</h2>
				<p class="mt-4 text-white/60">Fundadora de +EDU · Consultora en educación e innovación institucional · +20 años en educación</p>
			</div>

			<div class="mt-14 space-y-9 border-l border-white/15 pl-8" data-reveal style="--reveal-delay:120ms">
				{marcelaHitos.map((h) => (
					<div class="relative">
						<span class="absolute -left-[2.65rem] top-1.5 h-3.5 w-3.5 rounded-full bg-cyan-400 ring-4 ring-ink-900"></span>
						<p class="font-display text-2xl text-cyan-300">{h.k}</p>
						<p class="mt-2 max-w-3xl text-lg leading-relaxed text-white/80">{h.d}</p>
					</div>
				))}
			</div>

			<p class="mt-12 rounded-3xl border border-violet-400/40 bg-violet-500/10 px-8 py-6 text-center font-display text-xl italic sm:text-2xl" data-reveal>
				No asesora desde afuera. Asesora desde adentro. Conoce la realidad de la educación y sus actores.
			</p>
		</div>
	</section>

	<!-- ============ 5 · ECOSISTEMA / TRES PILARES ============ -->
	<section id="ecosistema" class="bg-white py-24 md:py-32">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<div class="max-w-3xl" data-reveal>
				<p class="eyebrow mb-5 text-violet-600">La propuesta</p>
				<h2 class="font-display text-4xl text-ink-900 sm:text-5xl md:text-[3.4rem]">Un ecosistema de tres pilares</h2>
				<p class="mt-5 text-lg leading-relaxed text-ink-600">
					No ofrecemos una solución aislada. Ofrecemos un ecosistema donde tres
					dimensiones se articulan y se refuerzan mutuamente.
				</p>
			</div>

			<div class="mt-14 grid gap-6 md:grid-cols-3">
				{pillars.map((p, i) => (
					<a href={p.href} class="group flex flex-col overflow-hidden rounded-4xl border border-ink-100 bg-white shadow-soft transition-transform duration-300 hover:-translate-y-1.5" data-reveal style={`--reveal-delay:${i * 110}ms`}>
						<div class={`h-2.5 w-full ${p.bar}`}></div>
						<div class="flex flex-1 flex-col p-8">
							<div class="flex items-center justify-between">
								<p class={`eyebrow ${p.nameColor}`}>{p.name}</p>
								<span class={`rounded-full px-3 py-1 text-[0.62rem] font-bold uppercase tracking-widest ${p.statusClass}`}>{p.status}</span>
							</div>
							<h3 class="mt-4 font-display text-2xl text-ink-900">{p.title}</h3>
							<p class="mt-3 text-ink-600">{p.body}</p>
							<ul class="mt-5 flex-1 space-y-2 text-sm text-ink-700">
								{p.items.map((it) => (<li class="flex gap-2"><span class="text-cyan-500">→</span>{it}</li>))}
							</ul>
							<span class="mt-6 inline-flex items-center gap-2 font-semibold text-violet-600 transition-colors group-hover:text-violet-700">
								Ver más
								<svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
							</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- ============ 6 · CAPACITACIONES ============ -->
	<section id="capacitaciones" class="bg-ink-900 py-24 text-white md:py-32">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<div class="max-w-3xl" data-reveal>
				<h2 class="font-display text-4xl sm:text-5xl">Programa de Capacitaciones</h2>
				<p class="mt-4 text-cyan-300">In-house en tu institución o jornadas abiertas · Disponibles ahora</p>
			</div>
			<div class="mt-12 space-y-3">
				{capacitaciones.map((c, i) => (
					<div class="flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-5 sm:flex-row sm:items-center sm:justify-between" data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
						<div class="flex items-center gap-5">
							<span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br ${c.grad} text-sm font-bold text-white`}>{c.n}</span>
							<div>
								<h3 class="font-display text-xl">{c.t}</h3>
								<p class="text-white/55">{c.p}</p>
							</div>
						</div>
						<span class="self-start rounded-full border border-cyan-400/30 px-4 py-1.5 text-sm text-cyan-200 sm:self-auto">{c.dur}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============ 7 · CONSULTORÍA ============ -->
	<section id="consultoria" class="bg-lavender-100 py-24 md:py-32">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<div class="max-w-3xl" data-reveal>
				<h2 class="font-display text-4xl text-ink-900 sm:text-5xl">Consultoría</h2>
				<p class="mt-4 text-lg text-ink-600">Acompañamiento institucional · Procesos con entregables concretos · Entrada gratuita: diagnóstico de 30 min</p>
			</div>
			<div class="mt-12 grid gap-5 md:grid-cols-2">
				{servicios.map((s, i) => (
					<div class="flex flex-col rounded-4xl bg-white p-8 shadow-soft" data-reveal style={`--reveal-delay:${(i % 2) * 110}ms`}>
						<span class={`self-start rounded-full px-3 py-1 text-[0.62rem] font-bold uppercase tracking-widest ${s.tagClass}`}>{s.tag}</span>
						<h3 class="mt-4 font-display text-2xl text-ink-900">{s.t}</h3>
						<p class="mt-3 flex-1 text-ink-600">{s.d}</p>
						<p class="mt-5 border-t border-ink-100 pt-4 text-sm italic text-cyan-700">{s.meta}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============ 8 · +EDUMAP ============ -->
	<section id="edumap" class="bg-ink-900 py-24 text-white md:py-32">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<div class="max-w-3xl" data-reveal>
				<div class="mb-4 flex items-center gap-3">
					<h2 class="font-display text-4xl sm:text-6xl text-cyan-300">+EduMap</h2>
					<span class="rounded-full px-3 py-1 text-[0.62rem] font-bold uppercase tracking-widest text-violet-300 ring-1 ring-violet-400/30">En desarrollo</span>
				</div>
				<p class="text-lg leading-relaxed text-white/70">Plataforma de gestión psicopedagógica integral: del despistaje al seguimiento longitudinal, en un mismo sistema.</p>
			</div>

			<div class="mt-12 grid gap-5 md:grid-cols-2">
				<div class="overflow-hidden rounded-4xl border border-white/10 bg-white/[0.03]" data-reveal>
					<div class="h-2.5 w-full bg-cyan-400"></div>
					<div class="p-8">
						<h3 class="font-display text-xl text-cyan-300">Módulo 1 — Despistaje y Detección</h3>
						<ul class="mt-5 space-y-3 text-white/80">
							{eduMod1.map((it) => (<li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-400"></span>{it}</li>))}
						</ul>
					</div>
				</div>
				<div class="overflow-hidden rounded-4xl border border-white/10 bg-white/[0.03]" data-reveal style="--reveal-delay:110ms">
					<div class="h-2.5 w-full bg-violet-500"></div>
					<div class="p-8">
						<h3 class="font-display text-xl text-violet-300">Módulo 2 — Adecuación Curricular</h3>
						<ul class="mt-5 space-y-3 text-white/80">
							{eduMod2.map((it) => (<li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-400"></span>{it}</li>))}
						</ul>
					</div>
				</div>
			</div>

			<p class="mt-12 text-center eyebrow text-white/45" data-reveal>Dos perfiles de usuario en el mismo sistema</p>
			<div class="mt-6 grid gap-5 md:grid-cols-2">
				<div class="rounded-4xl border border-cyan-400/25 bg-white/[0.03] p-8" data-reveal>
					<h4 class="font-display text-lg text-cyan-300">Equipo Psicopedagógico</h4>
					<p class="mt-3 text-white/70">Panel técnico especializado con acceso completo a datos clínicos, gestión de perfiles y configuración de instrumentos de despistaje.</p>
				</div>
				<div class="rounded-4xl border border-violet-400/25 bg-white/[0.03] p-8" data-reveal style="--reveal-delay:110ms">
					<h4 class="font-display text-lg text-violet-300">Docente de Aula</h4>
					<p class="mt-3 text-white/70">Panel pedagógico accesible: recomendaciones prácticas por materia, biblioteca de metodologías y generador de rúbricas.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ============ 9 · PARA QUIÉN ============ -->
	<section class="bg-white py-24 md:py-32">
		<div class="mx-auto max-w-6xl px-5 sm:px-8">
			<h2 class="font-display text-4xl text-ink-900 sm:text-5xl" data-reveal>¿Para quién trabajamos?</h2>
			<div class="mt-12 rounded-4xl bg-lavender-100 p-9 sm:p-12" data-reveal style="--reveal-delay:100ms">
				<div class="flex items-center justify-between">
					<h3 class="font-display text-3xl text-ink-900">Centros Educativos</h3>
					<div class="flex gap-2.5">
						<span class="h-4 w-4 rounded-full bg-cyan-400"></span>
						<span class="h-4 w-4 rounded-full bg-violet-500"></span>
					</div>
				</div>
				<ul class="mt-8 grid gap-5 sm:grid-cols-2">
					{audiencia.map((a) => (
						<li class="flex items-start gap-3 text-lg text-ink-700">
							<span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-violet-500"></span>{a}
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<!-- ============ 10 · CONTACTO / CTA ============ -->
	<section id="contacto" class="bg-ink-900 py-24 text-white md:py-32">
		<div class="mx-auto max-w-3xl px-5 text-center sm:px-8" data-reveal>
			<Arch class="mx-auto mb-8 h-14 w-auto" />
			<h2 class="font-display text-4xl sm:text-5xl md:text-[3.4rem]">¿Tu institución se reconoce en esto?</h2>
			<p class="mt-6 text-white/60">El punto de partida es siempre el mismo:</p>
			<div class="mx-auto mt-6 max-w-xl rounded-3xl bg-cyan-400 px-6 py-5">
				<p class="font-display text-xl text-ink-900 sm:text-2xl">Una conversación de 30 minutos para entender tu institución</p>
			</div>
			<div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
				<Button href={contact.whatsappCtaHref} variant="light" arrow>WhatsApp</Button>
				<a href={contact.emailHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3.5 font-semibold text-white transition-colors duration-300 hover:bg-white/5">Enviar email</a>
			</div>
		</div>
	</section>
</Layout>
