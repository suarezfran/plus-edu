---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const lineas = [
	{
		n: "01",
		accent: "bg-cyan-400",
		dot: "text-cyan-500",
		title: "Innovación Pedagógica",
		publico: "Equipos docentes y coordinadores pedagógicos",
		duracion: "Jornada de 4 h o taller de 3 sesiones · presencial o remoto",
		topics: [
			"Qué es —y qué no es— innovación pedagógica: desmitificando el concepto.",
			"Metodologías activas con aplicación real: ABP, aula invertida, aprendizaje cooperativo.",
			"Evaluación por competencias: cómo medir lo que realmente importa.",
			"Diseño de experiencias de aprendizaje con sentido y con datos.",
			"Taller práctico: rediseñar una unidad didáctica con enfoque innovador.",
		],
	},
	{
		n: "02",
		accent: "bg-iris-500",
		dot: "text-iris-500",
		title: "Bullying y Convivencia Escolar",
		publico: "Docentes, equipos de bienestar estudiantil y directivos",
		duracion: "Jornada de 6 h o módulo de 4 sesiones",
		topics: [
			"Definición y tipos de bullying: físico, verbal, social y ciberbullying.",
			"Cómo identificar situaciones de acoso con criterios claros, no intuitivos.",
			"Protocolos de actuación: qué hacer, quién activa, cómo documentar.",
			"El rol del docente testigo: intervención sin escalada.",
			"Convivencia positiva desde la prevención y comunicación con familias.",
		],
	},
	{
		n: "03",
		accent: "bg-violet-500",
		dot: "text-violet-500",
		title: "Manejo de Aula",
		publico: "Docentes de todos los niveles — énfasis en educación media",
		duracion: "Taller de 3 sesiones de 2 h o jornada intensiva de 6 h",
		topics: [
			"Qué produce el desorden: causas reales más allá de “no respetan”.",
			"Gestión del grupo sin recurrir al castigo o la autoridad formal.",
			"El vínculo docente-alumno como herramienta pedagógica.",
			"Regulación emocional del docente en situaciones de tensión.",
			"Normas y límites construidos con el grupo, no impuestos.",
		],
	},
];

const ia = [
	{
		code: "4A",
		para: "Para docentes",
		dur: "Taller · 3 sesiones de 2 h",
		points: "IA aplicada a la planificación, diferenciación pedagógica, evaluación y criterios éticos de uso con estudiantes.",
	},
	{
		code: "4B",
		para: "Para estudiantes",
		dur: "Bachillerato · 2 sesiones de 2 h",
		points: "Cómo funciona la IA, usarla como herramienta y no como trampa, pensamiento crítico, privacidad y uso responsable.",
	},
	{
		code: "4C",
		para: "Para familias",
		dur: "Charla-taller · 2 h",
		points: "Qué es la IA y por qué sus hijos ya la usan, riesgos reales vs. miedos, y cómo acompañar el uso en casa.",
	},
];
---

<Layout
	title="Capacitaciones — +EDU Consultora"
	description="Cuatro líneas formativas para equipos docentes, directivos, estudiantes y familias: innovación pedagógica, convivencia, manejo de aula e IA en educación."
>
	<PageHero eyebrow="Capacitación" tag="Disponible hoy">
		<Fragment slot="title">
			Formación que nace <span class="text-gradient italic">dentro del aula</span>
		</Fragment>
		<Fragment slot="intro">
			Nuestras capacitaciones responden a necesidades reales y urgentes del sector,
			y están diseñadas por alguien que trabaja activamente dentro del sistema educativo.
		</Fragment>
	</PageHero>

	<!-- formato -->
	<section class="border-b border-ink-100 bg-white py-12">
		<div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 sm:px-8 md:flex-row md:items-center md:justify-between" data-reveal>
			<div class="flex flex-wrap gap-3">
				<span class="rounded-full bg-lavender-200 px-4 py-2 text-sm font-semibold text-ink-700">In-house, con tu equipo real</span>
				<span class="rounded-full bg-lavender-200 px-4 py-2 text-sm font-semibold text-ink-700">Jornadas abiertas con inscripción individual</span>
			</div>
			<p class="max-w-md text-ink-500">Presencial o remoto, adaptado al calendario y a los desafíos concretos de la institución.</p>
		</div>
	</section>

	<!-- líneas 1-3 -->
	<section class="bg-white py-20 md:py-28">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="mb-16 max-w-2xl" data-reveal>
				<p class="eyebrow mb-5 text-violet-600">El programa</p>
				<h2 class="font-display text-4xl text-ink-900 sm:text-5xl">Cuatro líneas formativas</h2>
			</div>

			<div class="space-y-px overflow-hidden rounded-4xl border border-ink-100">
				{lineas.map((l) => (
					<div class="grid gap-6 border-b border-ink-100 bg-white p-8 last:border-0 sm:p-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-12" data-reveal>
						<div>
							<div class="flex items-start gap-4">
								<span class="font-display text-5xl text-ink-200">{l.n}</span>
								<div class={`mt-3 h-1.5 w-10 rounded-full ${l.accent}`}></div>
							</div>
							<h3 class="mt-4 font-display text-2xl text-ink-900 sm:text-3xl">{l.title}</h3>
							<dl class="mt-6 space-y-3 text-sm">
								<div>
									<dt class="eyebrow text-ink-400">Público</dt>
									<dd class="mt-1 text-ink-700">{l.publico}</dd>
								</div>
								<div>
									<dt class="eyebrow text-ink-400">Duración</dt>
									<dd class="mt-1 text-ink-700">{l.duracion}</dd>
								</div>
							</dl>
						</div>
						<ul class="space-y-3 lg:border-l lg:border-ink-100 lg:pl-12">
							{l.topics.map((t) => (
								<li class="flex gap-3 text-ink-600">
									<svg class={`mt-1.5 h-4 w-4 flex-none ${l.dot}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
									<span set:html={t} />
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- línea 4: IA -->
	<section class="bg-lavender-100 py-20 md:py-28">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="max-w-2xl" data-reveal>
				<div class="mb-5 flex items-center gap-3">
					<span class="font-display text-2xl text-gradient">04</span>
					<p class="eyebrow text-violet-600">Para toda la comunidad</p>
				</div>
				<h2 class="font-display text-4xl text-ink-900 sm:text-5xl">IA en Educación</h2>
				<p class="mt-6 text-lg leading-relaxed text-ink-600">
					Tres versiones para tres públicos con objetivos distintos. Se contratan por
					separado o como un programa integrado para toda la comunidad educativa.
				</p>
			</div>

			<div class="mt-14 grid gap-5 md:grid-cols-3">
				{ia.map((v) => (
					<div class="flex flex-col rounded-4xl bg-white p-8" data-reveal>
						<span class="font-display text-4xl text-gradient">{v.code}</span>
						<h3 class="mt-3 font-display text-xl text-ink-900">{v.para}</h3>
						<p class="mt-1 text-sm font-medium text-ink-400">{v.dur}</p>
						<p class="mt-5 text-ink-600">{v.points}</p>
					</div>
				))}
			</div>

			<div class="mt-8 flex flex-col gap-5 rounded-4xl bg-ink-900 p-8 text-white sm:flex-row sm:items-center sm:justify-between sm:p-10" data-reveal>
				<div>
					<h3 class="font-display text-2xl">Programa integrado</h3>
					<p class="mt-2 max-w-xl text-white/70">
						Las tres versiones a precio especial para cubrir a docentes, estudiantes y
						familias en un mismo semestre. Incluye una sesión de cierre comunitaria opcional.
					</p>
				</div>
				<span class="eyebrow shrink-0 rounded-full px-4 py-2 text-cyan-300 ring-1 ring-cyan-400/30">Toda la comunidad</span>
			</div>
		</div>
	</section>

	<CtaBand
		title="¿Querés llevar una capacitación a tu institución?"
		text="Conversemos sobre el equipo, los desafíos y el formato que mejor se adapta a tu calendario."
	/>
</Layout>
