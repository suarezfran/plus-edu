<section id="queremos" class="scroll-section relative flex items-center bg-gradient-to-br from-gold-50 via-white to-gold-50/40 overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-[0.04]">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, #cb8a03 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>

    <!-- Floating Elements -->
    <div class="absolute top-20 left-10 w-24 h-24 bg-gold-200/40 rounded-full blur-2xl animate-float"></div>
    <div class="absolute bottom-20 right-10 w-36 h-36 bg-navy-200/30 rounded-full blur-3xl animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/4 w-16 h-16 bg-gold-300/30 rounded-full blur-xl animate-float" style="animation-delay: 1s;"></div>

    <div class="relative max-w-7xl mx-auto px-6 md:px-12 py-24 sm:py-20">
        <!-- Header Section -->
        <div class="text-center mb-10 sm:mb-14 md:mb-16">
            <span class="inline-block mb-4 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase text-gold-600">Objetivos</span>
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-navy-900 mb-5 relative inline-block">
                Queremos
                <span class="absolute -bottom-3 left-1/2 -translate-x-1/2 w-20 h-1.5 bg-gradient-to-r from-gold-400 to-gold-500 rounded-full"></span>
            </h2>
            <p class="text-lg md:text-xl text-navy-600 max-w-2xl mx-auto leading-relaxed">
                Nuestros objetivos y aspiraciones para transformar la educación y crear un impacto positivo
            </p>
        </div>

        <!-- Goals Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
            <!-- Ser referentes -->
            <div class="group relative h-full">
                <div class="absolute -inset-0.5 bg-gradient-to-r from-gold-400 to-gold-500 rounded-3xl blur opacity-0 group-hover:opacity-25 transition-opacity duration-500"></div>
                <div class="relative bg-white/80 backdrop-blur-sm p-6 md:p-8 lg:p-10 rounded-3xl shadow-xl shadow-navy-900/5 hover:shadow-2xl hover:shadow-navy-900/10 transition-all duration-500 transform hover:-translate-y-2 border border-navy-100 text-center h-full flex flex-col items-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 bg-gradient-to-br from-navy-700 to-navy-900 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-navy-900/20 ring-1 ring-gold-400/0 group-hover:ring-gold-400/50 group-hover:scale-110 transition-all duration-300">
                        <svg class="w-7 h-7 sm:w-8 sm:h-8 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold text-navy-900 mb-3 group-hover:text-navy-700 transition-colors duration-300">
                        Ser referentes
                    </h3>
                    <p class="text-navy-600/90 leading-relaxed text-sm sm:text-base md:text-lg">
                        Ser referentes a nivel nacional en aspectos relacionados con
                        educación.
                    </p>
                    <div class="absolute bottom-0 left-8 right-8 h-1 bg-gradient-to-r from-gold-400 to-gold-500 rounded-full transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                </div>
            </div>

            <!-- Mejorar calidad -->
            <div class="group relative h-full">
                <div class="absolute -inset-0.5 bg-gradient-to-r from-gold-400 to-gold-500 rounded-3xl blur opacity-0 group-hover:opacity-25 transition-opacity duration-500"></div>
                <div class="relative bg-white/80 backdrop-blur-sm p-6 md:p-8 lg:p-10 rounded-3xl shadow-xl shadow-navy-900/5 hover:shadow-2xl hover:shadow-navy-900/10 transition-all duration-500 transform hover:-translate-y-2 border border-navy-100 text-center h-full flex flex-col items-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 bg-gradient-to-br from-navy-700 to-navy-900 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-navy-900/20 ring-1 ring-gold-400/0 group-hover:ring-gold-400/50 group-hover:scale-110 transition-all duration-300">
                        <svg class="w-7 h-7 sm:w-8 sm:h-8 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold text-navy-900 mb-3 group-hover:text-navy-700 transition-colors duration-300">
                        Calidad educativa
                    </h3>
                    <p class="text-navy-600/90 leading-relaxed text-sm sm:text-base md:text-lg">
                        Trabajar para mejorar la calidad de los procesos y
                        relaciones vividas en los centros educativos.
                    </p>
                    <div class="absolute bottom-0 left-8 right-8 h-1 bg-gradient-to-r from-gold-400 to-gold-500 rounded-full transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                </div>
            </div>

            <!-- Fidelización -->
            <div class="group relative h-full">
                <div class="absolute -inset-0.5 bg-gradient-to-r from-gold-400 to-gold-500 rounded-3xl blur opacity-0 group-hover:opacity-25 transition-opacity duration-500"></div>
                <div class="relative bg-white/80 backdrop-blur-sm p-6 md:p-8 lg:p-10 rounded-3xl shadow-xl shadow-navy-900/5 hover:shadow-2xl hover:shadow-navy-900/10 transition-all duration-500 transform hover:-translate-y-2 border border-navy-100 text-center h-full flex flex-col items-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 bg-gradient-to-br from-navy-700 to-navy-900 rounded-2xl flex items-center justify-center mb-6 shadow-lg shadow-navy-900/20 ring-1 ring-gold-400/0 group-hover:ring-gold-400/50 group-hover:scale-110 transition-all duration-300">
                        <svg class="w-7 h-7 sm:w-8 sm:h-8 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
