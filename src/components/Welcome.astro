<section
    id="welcome"
    class="scroll-section relative flex items-center justify-center overflow-hidden"
>
    <!-- Background Video -->
    <div class="absolute inset-0 w-full h-full">
        <video
            autoplay
            muted
            loop
            playsinline
            class="w-full h-full object-cover"
        >
            <source src="/background-video.mp4" type="video/mp4" />
        </video>
        <!-- Brand navy overlay for legibility -->
        <div class="absolute inset-0 bg-gradient-to-br from-navy-950/85 via-navy-900/75 to-navy-800/65"></div>
        <!-- Vignette to anchor the content -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,rgba(12,26,51,0.55)_100%)]"></div>
    </div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 text-center">
        <div class="space-y-8">
            <!-- Eyebrow -->
            <div class="flex justify-center animate-fade-in-up opacity-0" style="animation-delay: 0.1s; animation-fill-mode: forwards;">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-gold-400/40 bg-white/5 backdrop-blur-sm text-gold-300 text-xs sm:text-sm font-semibold tracking-[0.15em] uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                    Educación Innovadora
                </span>
            </div>

            <!-- Main Heading -->
            <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.05] tracking-tight">
                <span class="block animate-fade-in-up opacity-0" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
                    Inspiración para el
                </span>
                <span class="block animate-fade-in-up opacity-0" style="animation-delay: 0.5s; animation-fill-mode: forwards;">
                    <span class="bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 bg-clip-text text-transparent animate-glow" style="background-size: 200% 200%; animation: gradientShift 6s ease-in-out infinite, glow 2.4s ease-in-out infinite alternate;">
                        Futuro
                    </span>
                </span>
            </h1>

            <!-- Subtitle -->
            <div class="animate-fade-in-up opacity-0" style="animation-delay: 0.8s; animation-fill-mode: forwards;">
                <p class="text-base sm:text-lg md:text-xl lg:text-2xl max-w-3xl mx-auto leading-relaxed tracking-wide">
                    <span class="block mb-2 text-slate-200 font-light">La educación innovadora empodera a los estudiantes</span>
                    <span class="block text-transparent bg-gradient-to-r from-gold-200 via-gold-300 to-gold-400 bg-clip-text font-semibold">
                        para enfrentar el futuro con creatividad y pensamiento crítico.
                    </span>
                </p>
            </div>

            <!-- Call to action -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2 animate-fade-in-up opacity-0" style="animation-delay: 1.1s; animation-fill-mode: forwards;">
                <a
                    href="#hacemos"
                    class="group inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-gold-400 text-navy-950 font-semibold shadow-xl shadow-gold-500/20 hover:bg-gold-300 hover:-translate-y-0.5 transition-all duration-300"
                >
                    <span>Conoce qué hacemos</span>
                    <svg class="w-5 h-5 group-hover:translate-x-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
                <a
                    href="#contacto"
                    class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-white/30 text-white font-semibold backdrop-blur-sm hover:bg-white/10 hover:border-white/50 transition-all duration-300"
                >
                    Contacto
                </a>
            </div>
        </div>
    </div>

    <!-- Scroll-down indicator -->
    <a href="#hacemos" aria-label="Desplázate hacia abajo" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 text-white/70 hover:text-white transition-colors duration-300 animate-fade-in opacity-0" style="animation-delay: 1.4s; animation-fill-mode: forwards;">
        <span class="text-[11px] font-medium tracking-[0.2em] uppercase">Scroll</span>
        <span class="w-6 h-10 rounded-full border-2 border-current flex justify-center p-1.5">
            <span class="w-1 h-2 rounded-full bg-current animate-bounce"></span>
        </span>
    </a>

    <!-- Floating accent elements -->
    <div class="absolute top-24 left-10 w-4 h-4 bg-gold-400/40 rounded-full animate-float"></div>
    <div class="absolute top-40 right-20 w-6 h-6 bg-white/15 rounded-full animate-float" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-44 left-20 w-3 h-3 bg-gold-300/50 rounded-full animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute bottom-24 right-12 w-5 h-5 bg-gold-400/30 rounded-full animate-float" style="animation-delay: 0.5s;"></div>
    <div class="absolute top-1/2 left-1/4 w-2 h-2 bg-white/40 rounded-full animate-pulse-slow"></div>
    <div class="absolute bottom-1/2 right-1/4 w-3 h-3 bg-gold-200/30 rounded-full animate-pulse-slow" style="animation-delay: 1.5s;"></div>
</section>
