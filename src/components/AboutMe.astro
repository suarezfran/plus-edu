<section id="aboutme" class="scroll-section relative flex items-center bg-gradient-to-br from-gold-50 via-white to-gold-50/40 overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-[0.04]">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, #cb8a03 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>

    <!-- Floating Elements -->
    <div class="absolute top-20 left-10 w-24 h-24 bg-gold-200/40 rounded-full blur-2xl animate-float"></div>
    <div class="absolute bottom-20 right-10 w-36 h-36 bg-navy-200/30 rounded-full blur-3xl animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/4 w-16 h-16 bg-gold-300/30 rounded-full blur-xl animate-float" style="animation-delay: 1s;"></div>

    <div class="relative max-w-7xl mx-auto px-6 md:px-12 py-24 sm:py-20">
        <!-- Header Section -->
        <div class="text-center mb-10 sm:mb-14 md:mb-16">
            <span class="inline-block mb-4 text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase text-gold-600">Quiénes somos</span>
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-navy-900 mb-5 relative inline-block">
                Somos
                <span class="absolute -bottom-3 left-1/2 -translate-x-1/2 w-20 h-1.5 bg-gradient-to-r from-gold-400 to-gold-500 rounded-full"></span>
            </h2>
            <p class="text-lg md:text-xl text-navy-600 max-w-2xl mx-auto leading-relaxed">
                Conoce nuestro equipo y nuestra misión educativa
            </p>
        </div>

        <!-- Main Content Card -->
        <div class="max-w-4xl mx-auto">
            <div class="group relative">
                <div class="absolute -inset-0.5 bg-gradient-to-r from-gold-400 to-gold-500 rounded-3xl blur opacity-0 group-hover:opacity-25 transition-opacity duration-500"></div>
                <div class="relative bg-white/80 backdrop-blur-sm p-8 sm:p-10 md:p-14 lg:p-16 rounded-3xl shadow-xl shadow-navy-900/5 hover:shadow-2xl hover:shadow-navy-900/10 transition-all duration-500 transform hover:-translate-y-2 border border-navy-100 text-center">
                    <!-- Profile Photo -->
                    <div class="w-28 h-28 sm:w-32 sm:h-32 md:w-36 md:h-36 mx-auto mb-8 relative group-hover:scale-105 transition-transform duration-300">
                        <div class="absolute -inset-2 bg-gradient-to-br from-navy-700 to-navy-900 rounded-full blur-md opacity-30"></div>
                        <div class="relative w-full h-full rounded-full overflow-hidden shadow-2xl ring-4 ring-gold-400">
                            <img
                                src="/foto-perfil.png"
                                alt="Perfil del equipo"
                                class="w-full h-full object-cover"
                            />
                        </div>
                    </div>

                    <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-navy-900 mb-5 group-hover:text-navy-700 transition-colors duration-300">
                        Nuestro Equipo
                    </h3>

                    <p class="text-navy-600/90 leading-relaxed text-base sm:text-lg md:text-xl max-w-3xl mx-auto">
                        Somos un grupo de profesionales convencidos de la importancia de
                        pensar las instituciones educativas con el propósito de
                        potenciar las relaciones entre los diferentes actores, los
                        aprendizajes y el desarrollo personal.
                    </p>

                    <!-- Decorative Line -->
                    <div class="absolute bottom-0 left-1/4 right-1/4 h-1 bg-gradient-to-r from-gold-400 to-gold-500 rounded-full transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
                </div>
            </div>
        </div>
    </div>
</section>
