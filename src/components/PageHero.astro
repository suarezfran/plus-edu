---
interface Props {
	eyebrow: string;
	tag?: string;
}
const { eyebrow, tag } = Astro.props;
---

<section class="relative overflow-hidden bg-ink-900 text-white">
	<div class="pointer-events-none absolute inset-0">
		<div class="absolute -left-24 top-0 h-96 w-96 rounded-full bg-iris-600/25 blur-[110px]"></div>
		<div class="absolute right-0 -top-10 h-80 w-80 rounded-full bg-cyan-500/15 blur-[110px]"></div>
	</div>
	<div class="relative mx-auto max-w-7xl px-5 pb-20 pt-36 sm:px-8 lg:pb-24 lg:pt-44">
		<div class="max-w-3xl" data-reveal>
			<div class="mb-6 flex flex-wrap items-center gap-3">
				<p class="eyebrow text-cyan-300">{eyebrow}</p>
				{tag && (
					<span class="eyebrow rounded-full px-3 py-1 text-[0.62rem] text-white/70 ring-1 ring-white/20">{tag}</span>
				)}
			</div>
			<h1 class="font-display text-4xl leading-[1.05] sm:text-5xl md:text-6xl">
				<slot name="title" />
			</h1>
			<div class="mt-7 max-w-2xl text-lg leading-relaxed text-white/75">
				<slot name="intro" />
			</div>
		</div>
	</div>
</section>
