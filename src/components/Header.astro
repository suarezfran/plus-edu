---
import { nav } from "../lib/site.ts";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href.replace(/\/$/, "");
const mainLinks = nav.filter((n) => n.href !== "#contacto");
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
	<div
		id="header-bar"
		class="absolute inset-0 bg-white/80 backdrop-blur-xl border-b border-ink-100/80 transition-all duration-300"
	>
	</div>

	<nav class="relative mx-auto flex h-20 max-w-7xl items-center justify-between gap-6 px-5 sm:px-8">
		<!-- Brand -->
		<a href="/" class="group flex items-center" aria-label="+EDU Consultora — Inicio">
			<img src="/logo.svg" alt="+EDU Consultora" class="h-16 w-auto transition-transform duration-300 group-hover:-translate-y-0.5" />
		</a>

		<!-- Desktop nav -->
		<div class="hidden items-center gap-1 lg:flex">
			{mainLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						"relative px-4 py-2 text-[0.95rem] font-medium transition-colors duration-200",
						isActive(link.href) ? "text-violet-600" : "text-ink-600 hover:text-ink-900",
					]}
				>
					{link.label}
					<span
						class:list={[
							"absolute inset-x-4 -bottom-0.5 h-0.5 rounded-full bg-gradient-to-r from-cyan-400 to-violet-500 transition-transform duration-300 origin-left",
							isActive(link.href) ? "scale-x-100" : "scale-x-0",
						]}
					></span>
				</a>
			))}
			<a
				href="#contacto"
				class="ml-3 inline-flex items-center gap-2 rounded-full bg-ink-900 px-5 py-2.5 text-[0.95rem] font-semibold text-white transition-all duration-300 hover:bg-violet-600 hover:-translate-y-0.5"
			>
				Conversemos
				<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
			</a>
		</div>

		<!-- Mobile toggle -->
		<button
			id="menu-toggle"
			class="relative z-50 -mr-2 p-2.5 text-ink-900 lg:hidden"
			aria-label="Abrir menú"
			aria-expanded="false"
		>
			<svg id="icon-open" class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16"></path></svg>
			<svg id="icon-close" class="hidden h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 6l12 12M18 6L6 18"></path></svg>
		</button>
	</nav>

	<!-- Mobile overlay menu -->
	<div
		id="mobile-menu"
		class="fixed inset-0 z-40 hidden flex-col bg-ink-900 px-6 pt-28 pb-10 text-white lg:hidden"
	>
		<div class="flex flex-col gap-1">
			{nav.map((link, i) => (
				<a
					href={link.href}
					class:list={[
						"border-b border-white/10 py-5 font-display text-3xl font-medium transition-colors",
						isActive(link.href) ? "text-cyan-400" : "text-white hover:text-violet-300",
					]}
				>
					<span class="mr-3 text-sm font-sans text-white/40">0{i + 1}</span>{link.label}
				</a>
			))}
		</div>
		<a
			href="#contacto"
			class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-cyan-400 to-violet-500 px-6 py-4 text-lg font-semibold text-ink-950"
		>
			Agendá una llamada
		</a>
	</div>
</header>

<script>
	const header = document.getElementById("site-header");
	const bar = document.getElementById("header-bar");
	const toggle = document.getElementById("menu-toggle");
	const menu = document.getElementById("mobile-menu");
	const iconOpen = document.getElementById("icon-open");
	const iconClose = document.getElementById("icon-close");

	// Shadow + opacity on scroll
	const onScroll = () => {
		const s = window.scrollY > 24;
		bar?.classList.toggle("bg-white/90", s);
		bar?.classList.toggle("shadow-[0_8px_30px_-12px_rgba(18,14,49,0.18)]", s);
		bar?.classList.toggle("bg-white/80", !s);
	};
	window.addEventListener("scroll", onScroll, { passive: true });
	onScroll();

	// Mobile menu
	let open = false;
	const setMenu = (v: boolean) => {
		open = v;
		menu?.classList.toggle("hidden", !open);
		menu?.classList.toggle("flex", open);
		iconOpen?.classList.toggle("hidden", open);
		iconClose?.classList.toggle("hidden", !open);
		// keep the toggle visible over the dark overlay
		toggle?.classList.toggle("!text-white", open);
		toggle?.setAttribute("aria-expanded", String(open));
		document.body.style.overflow = open ? "hidden" : "";
	};
	toggle?.addEventListener("click", () => setMenu(!open));
	menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
	document.addEventListener("keydown", (e) => { if (e.key === "Escape" && open) setMenu(false); });
</script>
