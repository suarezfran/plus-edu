<header
    class="fixed top-0 left-0 w-full z-50 transition-all duration-500"
    id="header"
>
    <!-- Glass background -->
    <div class="absolute inset-0 bg-white/80 backdrop-blur-xl border-b border-navy-900/10" id="header-bg"></div>

    <!-- Subtle dotted pattern for an educational feel -->
    <div class="absolute inset-0 opacity-[0.04] pointer-events-none">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, #14284b 1px, transparent 0); background-size: 22px 22px;"></div>
    </div>

    <!-- Content -->
    <div class="relative flex items-center justify-between px-4 sm:px-6 lg:px-8 py-3 max-w-7xl mx-auto">
        <!-- Logo Section -->
        <a href="#welcome" class="flex items-center space-x-3 group" aria-label="Ir al inicio">
            <div class="relative">
                <img
                    src="/logo-plus-edu-removebg-preview.png"
                    alt="Logo +EDU"
                    class="h-10 sm:h-12 w-auto transition-transform duration-300 group-hover:scale-105"
                />
                <!-- Subtle gold glow on hover -->
                <div class="absolute inset-0 bg-gold-400/30 rounded-full blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <div class="flex flex-col leading-none">
                <span class="text-lg sm:text-xl font-bold text-navy-900 group-hover:text-gold-500 transition-colors duration-300">+EDU</span>
                <span class="text-[11px] sm:text-xs text-navy-400 font-semibold tracking-[0.18em] uppercase hidden sm:block">Educación Innovadora</span>
            </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center space-x-1">
            <a
                href="#hacemos"
                class="group relative px-4 py-2.5 text-navy-700 font-medium rounded-xl transition-colors duration-300 hover:text-navy-900 hover:bg-navy-50"
            >
                <span class="relative z-10 flex items-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                    <span>Hacemos</span>
                </span>
                <div class="absolute bottom-1 left-1/2 w-0 h-0.5 bg-gold-400 rounded-full transform -translate-x-1/2 group-hover:w-2/3 transition-all duration-300"></div>
            </a>
            <a
                href="#queremos"
                class="group relative px-4 py-2.5 text-navy-700 font-medium rounded-xl transition-colors duration-300 hover:text-navy-900 hover:bg-navy-50"
            >
                <span class="relative z-10 flex items-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <span>Queremos</span>
                </span>
                <div class="absolute bottom-1 left-1/2 w-0 h-0.5 bg-gold-400 rounded-full transform -translate-x-1/2 group-hover:w-2/3 transition-all duration-300"></div>
            </a>
            <a
                href="#vivimos"
                class="group relative px-4 py-2.5 text-navy-700 font-medium rounded-xl transition-colors duration-300 hover:text-navy-900 hover:bg-navy-50"
            >
                <span class="relative z-10 flex items-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span>Vivimos</span>
                </span>
                <div class="absolute bottom-1 left-1/2 w-0 h-0.5 bg-gold-400 rounded-full transform -translate-x-1/2 group-hover:w-2/3 transition-all duration-300"></div>
            </a>
            <a
                href="#aboutme"
                class="group relative px-4 py-2.5 text-navy-700 font-medium rounded-xl transition-colors duration-300 hover:text-navy-900 hover:bg-navy-50"
            >
                <span class="relative z-10 flex items-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span>Somos</span>
                </span>
                <div class="absolute bottom-1 left-1/2 w-0 h-0.5 bg-gold-400 rounded-full transform -translate-x-1/2 group-hover:w-2/3 transition-all duration-300"></div>
            </a>
            <!-- Contact CTA -->
            <a
                href="#contacto"
                class="ml-2 inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-navy-900 text-white font-semibold shadow-lg shadow-navy-900/20 hover:bg-navy-800 hover:shadow-navy-900/30 hover:-translate-y-0.5 transition-all duration-300"
            >
                <span>Contacto</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </nav>


        <!-- Mobile Menu Button -->
        <button
            class="lg:hidden p-2.5 rounded-xl text-navy-800 hover:bg-navy-50 hover:text-gold-500 transition-colors duration-300"
            id="mobile-menu-button"
            aria-label="Toggle mobile menu"
        >
            <svg class="w-6 h-6 transition-transform duration-300" id="menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg class="w-6 h-6 transition-transform duration-300 hidden" id="close-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile Navigation -->
    <div class="lg:hidden absolute top-full left-0 w-full bg-white/95 backdrop-blur-xl border-b border-navy-900/10 transform -translate-y-full opacity-0 transition-all duration-500 shadow-xl" id="mobile-menu">
        <div class="px-4 py-6 space-y-1">
            <a
                href="#hacemos"
                class="group flex items-center space-x-3 px-4 py-3 text-navy-700 font-medium rounded-xl hover:bg-navy-50 hover:text-navy-900 transition-colors duration-300"
            >
                <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <span>Hacemos</span>
            </a>
            <a
                href="#queremos"
                class="group flex items-center space-x-3 px-4 py-3 text-navy-700 font-medium rounded-xl hover:bg-navy-50 hover:text-navy-900 transition-colors duration-300"
            >
                <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
                <span>Queremos</span>
            </a>
            <a
                href="#vivimos"
                class="group flex items-center space-x-3 px-4 py-3 text-navy-700 font-medium rounded-xl hover:bg-navy-50 hover:text-navy-900 transition-colors duration-300"
            >
                <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>Vivimos</span>
            </a>
            <a
                href="#aboutme"
                class="group flex items-center space-x-3 px-4 py-3 text-navy-700 font-medium rounded-xl hover:bg-navy-50 hover:text-navy-900 transition-colors duration-300"
            >
                <svg class="w-5 h-5 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span>Somos</span>
            </a>
            <a
                href="#contacto"
                class="flex items-center justify-center space-x-2 mt-3 px-4 py-3 rounded-xl bg-navy-900 text-white font-semibold hover:bg-navy-800 transition-colors duration-300"
            >
                <span>Contacto</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </div>
    </div>
</header>

<script>
    // Mobile menu toggle with icon switching
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    let isMenuOpen = false;

    mobileMenuButton?.addEventListener('click', () => {
        isMenuOpen = !isMenuOpen;

        if (isMenuOpen) {
            mobileMenu?.style.setProperty('transform', 'translateY(0)');
            mobileMenu?.style.setProperty('opacity', '1');
            menuIcon?.classList.add('hidden');
            closeIcon?.classList.remove('hidden');
        } else {
            mobileMenu?.style.setProperty('transform', 'translateY(-100%)');
            mobileMenu?.style.setProperty('opacity', '0');
            menuIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
        }
    });

    // Close mobile menu when clicking on a link
    const mobileLinks = mobileMenu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
        link.addEventListener('click', () => {
            isMenuOpen = false;
            mobileMenu?.style.setProperty('transform', 'translateY(-100%)');
            mobileMenu?.style.setProperty('opacity', '0');
            menuIcon?.classList.remove('hidden');
            closeIcon?.classList.add('hidden');
        });
    });

    // Enhanced header effect on scroll. The page scrolls inside `.scroll-container`,
    // not the window, so listen on that element.
    const header = document.getElementById('header');
    const headerBg = document.getElementById('header-bg');
    const scroller = document.querySelector('.scroll-container');

    const onScroll = () => {
        const scrolled = (scroller?.scrollTop ?? 0) > 40;
        headerBg?.classList.toggle('bg-white/95', scrolled);
        headerBg?.classList.toggle('bg-white/80', !scrolled);
        header?.classList.toggle('shadow-lg', scrolled);
        header?.classList.toggle('shadow-navy-900/5', scrolled);
    };
    scroller?.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Smooth scrolling for navigation links (scrolls within the snap container)
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', (e: Event) => {
            e.preventDefault();
            const href = (anchor as HTMLAnchorElement).getAttribute('href');
            if (href && href.length > 1) {
                const target = document.querySelector(href);
                target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });
</script>
