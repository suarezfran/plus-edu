---
import { nav, contact } from "../lib/site.ts";
---

<footer class="relative overflow-hidden bg-ink-900 text-white">
	<!-- gradient hairline -->
	<div class="h-px w-full bg-gradient-to-r from-transparent via-violet-500/60 to-transparent"></div>
	<!-- soft glow -->
	<div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-violet-600/15 blur-[100px]"></div>
	<div class="pointer-events-none absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-cyan-500/10 blur-[100px]"></div>

	<div class="relative mx-auto max-w-7xl px-5 sm:px-8">
		<!-- top: closing line -->
		<div class="grid gap-10 border-b border-white/10 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
			<div>
				<img src="/logo-edu.png" alt="+EDU Consultora" class="mb-6 h-24 w-auto" />
				<p class="max-w-sm text-[1.05rem] leading-relaxed text-white/70">
					Transformamos centros educativos en comunidades reales: donde estudiantes,
					docentes y familias dialogan, son atendidos y se desarrollan.
				</p>
			</div>

			<div>
				<h3 class="eyebrow mb-5 text-cyan-300">Explorar</h3>
				<ul class="space-y-3">
					{nav.map((link) => (
						<li>
							<a href={link.href} class="text-white/75 transition-colors hover:text-white">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<div>
				<h3 class="eyebrow mb-5 text-cyan-300">Hablemos</h3>
				<ul class="space-y-3 text-white/75">
					<li>
						<a href={contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 transition-colors hover:text-white">
							<span class="text-white/40 group-hover:text-cyan-300">WhatsApp</span> {contact.whatsapp}
						</a>
					</li>
					<li>
						<a href={contact.emailHref} class="break-all transition-colors hover:text-white">{contact.email}</a>
					</li>
					<li>
						<a href={contact.instagramHref} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">{contact.instagram}</a>
					</li>
					<li>
						<a href={contact.linkedinHref} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">LinkedIn · {contact.linkedin}</a>
					</li>
					<li>
						<a href={contact.siteHref} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-white">{contact.site}</a>
					</li>
				</ul>
			</div>
		</div>

		<!-- bottom bar -->
		<div class="flex flex-col items-center justify-between gap-4 py-7 text-sm text-white/45 sm:flex-row">
			<p>© 2026 +EDU Consultora · {contact.person}</p>
			<p>Educación inclusiva · Uruguay &amp; Latinoamérica</p>
		</div>
	</div>
</footer>
