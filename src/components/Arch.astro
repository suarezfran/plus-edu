---
// The +EDU double-arch ("m") motif, echoing the logo. Decorative.
interface Props {
	class?: string;
}
const { class: cls = "w-40 h-24" } = Astro.props;
const uid = "arch-" + Math.random().toString(36).slice(2, 8);
---

<svg
	class={cls}
	viewBox="0 0 200 116"
	fill="none"
	aria-hidden="true"
	role="presentation"
>
	<defs>
		<linearGradient id={`${uid}-l`} x1="20" y1="100" x2="110" y2="55" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#00d5e7" />
			<stop offset="1" stop-color="#6a60e6" />
		</linearGradient>
		<linearGradient id={`${uid}-r`} x1="92" y1="55" x2="180" y2="100" gradientUnits="userSpaceOnUse">
			<stop offset="0" stop-color="#6a60e6" />
			<stop offset="1" stop-color="#8259e1" />
		</linearGradient>
	</defs>
	<path d="M20 100 A 45 45 0 0 1 110 100" stroke={`url(#${uid}-l)`} stroke-width="13" stroke-linecap="round" />
	<path d="M90 100 A 45 45 0 0 1 180 100" stroke={`url(#${uid}-r)`} stroke-width="13" stroke-linecap="round" />
	<circle cx="20" cy="100" r="7.5" fill="#00d5e7" />
	<circle cx="180" cy="100" r="7.5" fill="#8259e1" />
</svg>
