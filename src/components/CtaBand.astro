---
import Arch from "./Arch.astro";
import Button from "./Button.astro";
interface Props {
	title?: string;
	text?: string;
}
const {
	title = "El primer paso es una conversación de 30 minutos",
	text = "No hace falta tener todo claro para hablar. Empezamos por entender la situación de tu institución y ver si +EDU puede acompañarte.",
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-iris-700 via-violet-700 to-violet-800 py-24 text-white md:py-28">
	<div class="pointer-events-none absolute -left-10 top-0 h-72 w-72 rounded-full bg-cyan-400/20 blur-[100px]"></div>
	<div class="relative mx-auto max-w-3xl px-5 text-center sm:px-8" data-reveal>
		<Arch class="mx-auto mb-8 h-14 w-auto" />
		<h2 class="font-display text-4xl sm:text-5xl">{title}</h2>
		<p class="mx-auto mt-6 max-w-xl text-lg text-white/80">{text}</p>
		<div class="mt-10 flex justify-center">
			<Button href="/contacto" variant="light" arrow>Agendá tu llamada</Button>
		</div>
	</div>
</section>
