---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "+EDU Consultora — Educación inclusiva",
	description = "+EDU transforma centros educativos en comunidades reales donde estudiantes, docentes y familias dialogan, son atendidos y se desarrollan. Capacitación, consultoría y la plataforma +EduMap.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#120e31" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" href="/logo-edu-mark.png" type="image/png" />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />

		<style is:global>
			:root {
				--header-h: 5rem;
			}

			html {
				scroll-behavior: smooth;
				scroll-padding-top: var(--header-h);
				-webkit-text-size-adjust: 100%;
			}

			body {
				margin: 0;
				padding: 0;
				overflow-x: hidden;
				background: #ffffff;
				color: #120e31;
				font-family: "Hanken Grotesk", system-ui, -apple-system, sans-serif;
				font-size: 1.0625rem;
				line-height: 1.65;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				text-rendering: optimizeLegibility;
			}

			h1, h2, h3, h4 {
				font-family: "Fraunces", Georgia, serif;
				font-weight: 600;
				letter-spacing: -0.015em;
				line-height: 1.08;
				text-wrap: balance;
			}

			p { text-wrap: pretty; }

			::selection {
				background: #825ae1;
				color: #fff;
			}

			::-webkit-scrollbar { width: 11px; }
			::-webkit-scrollbar-track { background: #f2f0fb; }
			::-webkit-scrollbar-thumb {
				background: #aaa1d6;
				border-radius: 9999px;
				border: 3px solid #f2f0fb;
			}
			::-webkit-scrollbar-thumb:hover { background: #8259e1; }

			/* Brand gradient text */
			.text-gradient {
				background-image: linear-gradient(100deg, #00d5e7 0%, #6a60e6 45%, #8259e1 90%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}
			@supports not (background-clip: text) {
				.text-gradient { color: #6a60e6; }
			}

			/* Editorial figure caption / small caps label */
			.eyebrow {
				font-weight: 700;
				font-size: 0.78rem;
				letter-spacing: 0.22em;
				text-transform: uppercase;
			}

			/* Scroll reveal */
			[data-reveal] {
				opacity: 0;
				transform: translateY(26px);
				transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
					transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
				transition-delay: var(--reveal-delay, 0ms);
				will-change: opacity, transform;
			}
			[data-reveal].is-visible {
				opacity: 1;
				transform: none;
			}

			@media (prefers-reduced-motion: reduce) {
				html { scroll-behavior: auto; }
				[data-reveal] { opacity: 1 !important; transform: none !important; transition: none; }
				*, *::before, *::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
				}
			}
		</style>

		<script>
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
			if (reduce || !("IntersectionObserver" in window)) {
				els.forEach((el) => el.classList.add("is-visible"));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((e) => {
							if (e.isIntersecting) {
								e.target.classList.add("is-visible");
								io.unobserve(e.target);
							}
						});
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
				);
				els.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>
