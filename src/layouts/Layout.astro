---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="La educación innovadora empodera a los estudiantes para enfrentar el futuro con creatividad y pensamiento crítico."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#14284b" />
		<link rel="icon" href="/favicon.ico" type="image/x-icon" />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main class="scroll-container">
			<slot />
			<Footer />
		</main>
	</body>
</html>
<style is:global>
	html {
		scroll-behavior: smooth;
		font-family: 'Inter', 'Poppins', system-ui, -apple-system, sans-serif;
	}

	body {
		margin: 0;
		padding: 0;
		overflow-x: hidden;
		background: #ffffff;
		color: #14284b;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
	}

	/* Branded text selection */
	::selection {
		background: #14284b;
		color: #ffffff;
	}

	/* Custom scrollbar */
	::-webkit-scrollbar {
		width: 10px;
	}

	::-webkit-scrollbar-track {
		background: #f1f5fb;
	}

	::-webkit-scrollbar-thumb {
		background: linear-gradient(to bottom, #1e3560, #14284b);
		border-radius: 9999px;
		border: 2px solid #f1f5fb;
	}

	::-webkit-scrollbar-thumb:hover {
		background: linear-gradient(to bottom, #fbc81b, #cb8a03);
	}

	/* Video optimization */
	video {
		object-fit: cover;
		object-position: center;
	}

	/* Gradient text support for older browsers */
	@supports not (background-clip: text) {
		.bg-clip-text {
			background: none;
			-webkit-background-clip: initial;
			-webkit-text-fill-color: #fbc81b;
		}
	}

	/* Scroll Snap — proximity is gentler than mandatory and never traps content */
	.scroll-container {
		scroll-snap-type: y proximity;
		scroll-padding-top: 5rem;
		overflow-y: scroll;
		overflow-x: hidden;
		height: 100vh;
	}

	.scroll-section {
		scroll-snap-align: start;
		min-height: 100vh;
	}

	/* The footer is shorter than the viewport — snap to its end so the
	   "Contacto" link reliably settles with the footer in view. */
	.scroll-container > footer {
		scroll-snap-align: end;
	}

	/* Respect users who prefer reduced motion */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}

	/* Mobile Optimizations */
	@media (max-width: 640px) {
		.scroll-section {
			padding: 1rem 0;
		}

		/* Improve touch scrolling on mobile */
		.scroll-container {
			-webkit-overflow-scrolling: touch;
		}

		/* Better text sizing on mobile */
		h1, h2, h3 {
			word-wrap: break-word;
			hyphens: auto;
		}

		/* Better button sizing on mobile */
		button, a {
			min-height: 44px;
		}
	}
</style>
